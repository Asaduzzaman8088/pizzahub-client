# PizzaHub Client Environment Variables

# Backend API Base URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ImgBB Image Upload API Key (optional, for vendor menu item uploads)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Google OAuth Client ID (must match GOOGLE_CLIENT_ID on the server)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
